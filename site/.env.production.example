# Copy to .env.production on the VPS. Never commit the completed file.
SITE_DOMAIN=example.com
SERVER_URL=https://example.com
POSTGRES_USER=wheelsite
POSTGRES_DB=wheelsite
POSTGRES_PASSWORD=replace-with-a-unique-database-password
DATABASE_URL=postgresql://wheelsite:replace-with-a-unique-database-password@db:5432/wheelsite
PAYLOAD_SECRET=replace-with-a-long-random-secret
S3_BUCKET=replace-with-bucket-name
S3_REGION=replace-with-provider-region
# Set S3_ENDPOINT for non-AWS S3-compatible services.
S3_ENDPOINT=
# Some providers, including Cloudflare R2, need true; check provider documentation.
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=replace-with-access-key
S3_SECRET_ACCESS_KEY=replace-with-secret-key
