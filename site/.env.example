# Local development only. Copy to .env and replace PAYLOAD_SECRET.
DATABASE_URL=postgresql://wheelsite:local_dev_password@127.0.0.1:5433/wheelsite
PAYLOAD_SECRET=replace-with-a-long-random-secret
# SERVER_URL=http://localhost:3000

# Production media uses an S3-compatible object store. Leave unset for local disk uploads.
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
